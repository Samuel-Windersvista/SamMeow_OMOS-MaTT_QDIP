{
  "$schema": "https://opencode.ai/config.json",
  "autoupdate": "notify",
  "plugin": [
    "../../../plugins/oh-my-opencode-slim",
    "../../../plugins/opencode-quota"
  ],
  "agent": {
    "explore": {
      "disable": true
    },
    "general": {
      "disable": true
    },
    "build": {
      "disable": true
    },
    "plan": {
      "disable": true
    }
  },
  "provider": {},
  "mcp": {
    "chrome-devtools": {
      "type": "local",
      "command": [
        "node",
        "{env:QDIP_MCP_CHROME}"
      ],
      "enabled": true
    }
  },
  "instructions": [
    "{env:QDIP_PREFERENCES}"
  ],
  "lsp": true
}
